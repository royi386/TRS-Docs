# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# docker-compose.yml reads these via variable substitution and refuses to start
# without ADMIN_PASSWORD.

# Required
# Admin password for the TRS-Docs web UI.
ADMIN_PASSWORD=change-me

# Optional — defaults shown
# Which AI backend answers questions: "ollama" (local, default) or "gemini" (hosted API key).
AI_PROVIDER=ollama
# Chat model pulled into the ollama container on first start.
OLLAMA_CHAT_MODEL=qwen2.5:7b
# Embedding model for search.
OLLAMA_EMBED_MODEL=nomic-embed-text
# How long models stay loaded between questions (Go duration).
OLLAMA_KEEP_ALIVE=300m
# Inference thread cap so Ollama leaves headroom for the app and OCR workers.
OLLAMA_NUM_THREADS=8
# Memory ceiling for the ollama container (uncomment in docker-compose.yml to enforce).
# OLLAMA_MEM_LIMIT=3g
